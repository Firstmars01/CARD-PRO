# Secrets et configuration locale (aucun n'est nécessaire aujourd'hui)
.env
.env.*

# Dépendances et fichiers système
node_modules/
.DS_Store
Thumbs.db
*.log

# Base de données locale (hors Docker) : seulement le dossier à la racine.
# Le « / » initial est indispensable : sous Windows, Git ignore la casse et
# « donnees/ » exclurait aussi les dossiers de code src/Donnees, serveur/Donnees…
/donnees/

# Lecteur QR du portefeuille : ajouté à la publication (voir portefeuille/vendor/LISEZMOI.md)
portefeuille/vendor/jsQR.js

# Appli Android : fichiers générés et clé de signature (à garder hors du dépôt !)
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/www/
android/local.properties
*.jks
*.keystore

cardpro.jks
mdp.txt