<!--
  Lanceur.csproj
  DrawCard-Configurateur.exe : lanceur Windows de DrawCard Configurateur. Il contient l'appli
  (Node.js + serveur + page web) dans un paquet ZIP intégré, la démarre en
  local, l'affiche dans une fenêtre (WebView2) et met une icône près de l'horloge.
  Les bibliothèques WebView2 sont intégrées à l'exe (un seul fichier à télécharger).
  Cible .NET Framework 4.8, présent sur tous les Windows 10 et 11 : rien à installer.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DrawCard-Configurateur</AssemblyName>
    <RootNamespace>DrawCard.Lanceur</RootNamespace>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <Product>DrawCard Configurateur</Product>
    <Company>DrawCard</Company>
    <Description>DrawCard : création des cartes de visite</Description>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <!-- Paquet de l'appli (préparé par .github/workflows/Configurateur.yml). -->
    <PaquetAppli Condition="'$(PaquetAppli)' == ''">..\..\_paquet\app.zip</PaquetAppli>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permet de compiler pour .NET Framework sans Visual Studio. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Fenêtre de l'appli (moteur d'Edge). GeneratePathProperty : chemin du paquet, pour intégrer ses DLL. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PaquetAppli)" LogicalName="app.zip" />
    <EmbeddedResource Include="icone.ico" LogicalName="icone.ico" />
    <!-- DLL WebView2 chargées depuis l'exe (voir ChargementWebView2.cs). -->
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="WebView2Loader-x64.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll" LogicalName="WebView2Loader-arm64.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll" LogicalName="WebView2Loader-x86.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dépôt GitHub (« compte/depot ») : mises à jour et adresse de l'appli mobile. -->
    <AssemblyMetadata Include="DepotGithub" Value="$(DepotGithub)" />
  </ItemGroup>
</Project>
